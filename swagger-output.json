    "/api/usuarios/login": {
      "post": {
        "tags": [
          "usuarios"
        ],
        "summary": "Permite a un usuario iniciar sesión con una cuenta activa.",
        "description": "",
        "responses": {
          "201": {
            "description": "Inscripción creada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioAutenticado"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo inválido o Bearer mal formado."
          },
          "401": {
            "description": "Token ausente o inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                },
                "example": {
                  "mensaje": "Se requiere un token de acceso."
                }
              }
            }
          },
          "403": {
            "description": "Cuenta inactiva."
          },
          "404": {
            "description": "Usuario no encontrado."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IniciarSesion"
              }
            }
          }
        }
      }
    },
