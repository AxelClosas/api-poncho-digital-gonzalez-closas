    "/api/inscripciones/postularse": {
      "post": {
        "tags": [
          "inscripciones"
        ],
        "summary": "Permite a un usuario postularse a un puesto en el Festival del Poncho.",
        "description": "",
        "responses": {
          "201": {
            "description": "Inscripción creada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostulacionCreada"
                }
              }
            }
          },
          "400": {
            "description": "Cuerpo inválido o Bearer mal formado."
          },
          "401": {
            "description": "Token ausente o inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorApi"
                },
                "example": {
                  "mensaje": "Se requiere un token de acceso."
                }
              }
            }
          },
          "403": {
            "description": "Cuenta inactiva."
          },
          "404": {
            "description": "Evento inexistente."
          },
          "409": {
            "description": "Inscripción duplicada o conflicto de datos."
          }
        },
        "security": [
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
