    {
      "name": "01 - Crear postulacion desde cero",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/inscripciones/postularse",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Lucas\",\n  \"apellido\": \"Pereyra\",\n  \"cuil\": \"{{postulanteCuil}}\",\n  \"fechaNacimiento\": \"1995-05-15\",\n  \"sexo\": \"M\",\n  \"email\": \"{{postulanteEmail}}\",\n  \"password\": \"Artesano123!\",\n  \"localidadId\": \"{{localidadId}}\",\n  \"emprendimiento\": {\n    \"nombre\": \"Tejidos del Valle\",\n    \"descripcion\": \"Tejidos artesanales de lana.\",\n    \"rubroId\": \"{{rubroId}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const required=[\"localidadId\",\"rubroId\",\"postulanteEmail\",\"postulanteCuil\"];",
              "const missing=required.filter(k => !pm.variables.get(k));",
              "if(missing.length){pm.execution.skipRequest();throw new Error('Completar variables: '+missing.join(', '));}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.unset('inscripcionNuevaId');",
              "if(pm.response.code===201) pm.collectionVariables.set('inscripcionNuevaId',pm.response.json().inscripcion.id);"
            ]
          }
        }
      ]
    },
