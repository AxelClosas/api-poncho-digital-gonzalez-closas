    {
      "name": "07 - Validar artesanos y capturar emprendimientos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/inscripciones?estadoId={{estadoAprobadoId}}&pagina=1&limite=50",
        "description": "Si alguno no aparece, ajustar pagina. Deben ser dos inscripciones aprobadas de usuarios distintos."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const required=[\"adminToken\",\"estadoAprobadoId\",\"inscripcionSinStandId\",\"inscripcionConStandId\"];",
              "const missing=required.filter(k => !pm.variables.get(k));",
              "if(missing.length){pm.execution.skipRequest();throw new Error('Completar variables: '+missing.join(', '));}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if(pm.response.code===200){const list=pm.response.json().inscripciones;for(const [ik,ek,withStand] of [['inscripcionSinStandId','emprendimientoSinStandId',false],['inscripcionConStandId','emprendimientoConStandId',true]]){pm.collectionVariables.unset(ek);if(withStand)pm.collectionVariables.unset('standAnteriorId');const i=list.find(x=>x.id===pm.collectionVariables.get(ik));pm.test('Inscripcion encontrada '+ik,()=>pm.expect(i).to.exist);if(i){const e=i.usuario.emprendimiento;pm.test('Tiene emprendimiento '+ik,()=>pm.expect(e).to.exist);if(e){pm.collectionVariables.set(ek,e.id);pm.test('Condicion inicial de stand '+ik,()=>pm.expect(Boolean(e.standId)).to.eql(withStand));if(withStand&&e.standId)pm.collectionVariables.set('standAnteriorId',e.standId);}}}}"
            ]
          }
        }
      ]
    },
